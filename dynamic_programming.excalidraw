    },
    {
      "id": "nYQ5ByUdRgyvDWu2qfyL2",
      "type": "text",
      "x": 751.233134692011,
      "y": 1472.8056071183682,
      "width": 304,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3h",
      "roundness": null,
      "seed": 1716796517,
      "version": 73,
      "versionNonce": 873051499,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765271151229,
      "link": null,
      "locked": false,
      "text": "综上：我们可以得到我们的状态转移方程：",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "综上：我们可以得到我们的状态转移方程：",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "T_YmymnG_k-TGepoMzsCA",
      "type": "text",
      "x": 1066.6279084177886,
      "y": 1469.1124153896326,
      "width": 320.33978271484375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3i",
      "roundness": null,
      "seed": 272797605,
      "version": 1060,
      "versionNonce": 464592101,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765271162724,
      "link": null,
      "locked": false,
      "text": "f(i,j) = f(i-1, j-v[i] * k) + w[i] * k",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(i,j) = f(i-1, j-v[i] * k) + w[i] * k",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "E-y15sAHw6m3cXOGouG2x",
      "type": "text",
      "x": 1407.79421640015,
      "y": 1469.4105715924916,
      "width": 98.159912109375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3k",
      "roundness": null,
      "seed": 1108646379,
      "version": 38,
      "versionNonce": 2047422245,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765271192872,
      "link": null,
      "locked": false,
      "text": "(k=0,1,2,3,...)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(k=0,1,2,3,...)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2NQU8hJm43gdkEMURX3Wv",
      "type": "text",
      "x": 429.10152889300673,
      "y": 1549.2735350052726,
      "width": 482.1399841308594,
      "height": 52.201696818581944,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b44",
      "roundness": null,
      "seed": 937159877,
      "version": 211,
      "versionNonce": 1259240811,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765272635993,
      "link": null,
      "locked": false,
      "text": "我们可以参照01背包问题写出容易想到的暴力解法：\n",
      "fontSize": 20.880678727432777,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "我们可以参照01背包问题写出容易想到的暴力解法：\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "J7YZbB2VLinxc6fVSMR1e",
      "type": "text",
      "x": 443.8862903980922,
      "y": 1604.2261299297868,
      "width": 695.1990356445312,
      "height": 480,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b45",
      "roundness": null,
      "seed": 792811941,
      "version": 421,
      "versionNonce": 1190197898,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765274586356,
      "link": null,
      "locked": false,
      "text": "\n#include <iostream>\n#include <algorithm>\n\nconst int N = 1010;\n\nint m, n;\nint v[N], w[N];\nint f[N][N];\n\n// FIXME: TLE -- Time Limit Exceeded\nint main() {\n    std::cin >> n >> m;\n    for (int i = 1; i <= n; i++) std::cin >> v[i] >> w[i];\n\n    for (int i = 1; i <= n; i++)\n        for (int j = 0; j <= m; j++)\n            for (int k = 0; k * v[i] <= j; k++)\n                f[i][j] = std::max(f[i][j], f[i - 1][j - v[i] * k] + k * w[i]);\n\n    std::cout << f[n][m] << '\\n';\n}\n\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n#include <iostream>\n#include <algorithm>\n\nconst int N = 1010;\n\nint m, n;\nint v[N], w[N];\nint f[N][N];\n\n// FIXME: TLE -- Time Limit Exceeded\nint main() {\n    std::cin >> n >> m;\n    for (int i = 1; i <= n; i++) std::cin >> v[i] >> w[i];\n\n    for (int i = 1; i <= n; i++)\n        for (int j = 0; j <= m; j++)\n            for (int k = 0; k * v[i] <= j; k++)\n                f[i][j] = std::max(f[i][j], f[i - 1][j - v[i] * k] + k * w[i]);\n\n    std::cout << f[n][m] << '\\n';\n}\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
