    {
      "id": "1alG8i1urzTU8lexlpONU",
      "type": "text",
      "x": -163.43959488567418,
      "y": 10982.299685400481,
      "width": 775.1997680664062,
      "height": 840,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#f5faff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAZ",
      "roundness": null,
      "seed": 725696316,
      "version": 217,
      "versionNonce": 297418628,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1767334228567,
      "link": null,
      "locked": false,
      "text": "#include <iostream>\n#include <algorithm>\n#include <cstring>\n\nusing namespace std;\n\n\n/// 摘花生问题\n///\n/// 有一个 n×m 的网格，每个格子里有若干颗花生。\n/// 你从 左上角 (1,1) 出发，只能向右或向下走， 走到右下角 (n,m)，走过的格子里的花生都可以摘走。\n/// 问：最多能摘多少花生？\n\nconst int N = 1010;\nint row, column;\nint a[N][N];\nint f[N][N];\n\nint main() {\n    // 有多少组\n    int group;\n    cin >> group;\n\n    while (group--) {\n        cin >> row >> column;\n        for (int i = 1; i <= row; i++) {\n            for (int j = 1; j <= column; j++) {\n                cin >> a[i][j];\n            }\n        }\n        // 清零\n        memset(f, 0, sizeof f);\n        for (int i = 1; i <= row; i++) {\n            for (int j = 1; j <= column; j++) {\n                f[i][j] = max(f[i - 1][j], f[i][j - 1]) + a[i][j];\n            }\n        }\n        cout << f[row][column] << endl;\n    }\n\n    return 0;\n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#include <iostream>\n#include <algorithm>\n#include <cstring>\n\nusing namespace std;\n\n\n/// 摘花生问题\n///\n/// 有一个 n×m 的网格，每个格子里有若干颗花生。\n/// 你从 左上角 (1,1) 出发，只能向右或向下走， 走到右下角 (n,m)，走过的格子里的花生都可以摘走。\n/// 问：最多能摘多少花生？\n\nconst int N = 1010;\nint row, column;\nint a[N][N];\nint f[N][N];\n\nint main() {\n    // 有多少组\n    int group;\n    cin >> group;\n\n    while (group--) {\n        cin >> row >> column;\n        for (int i = 1; i <= row; i++) {\n            for (int j = 1; j <= column; j++) {\n                cin >> a[i][j];\n            }\n        }\n        // 清零\n        memset(f, 0, sizeof f);\n        for (int i = 1; i <= row; i++) {\n            for (int j = 1; j <= column; j++) {\n                f[i][j] = max(f[i - 1][j], f[i][j - 1]) + a[i][j];\n            }\n        }\n        cout << f[row][column] << endl;\n    }\n\n    return 0;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
