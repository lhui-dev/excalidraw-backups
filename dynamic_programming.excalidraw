      "originalText": "S = 1 + 2 + 4 + 8 + ... + 2^k + c , c < 2^(k+1) ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "02B3c21OuY_vjpck_OyH_",
      "type": "text",
      "x": 1077.4561361727847,
      "y": 3942.1027838624136,
      "width": 690.8599853515625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f5faff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b91",
      "roundness": null,
      "seed": 1443291050,
      "version": 163,
      "versionNonce": 611336502,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766045449568,
      "link": null,
      "locked": false,
      "text": "就是把s个相同的物品拆分成若干组，直到不能拆为止，最后一个单独为一组。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "就是把s个相同的物品拆分成若干组，直到不能拆为止，最后一个单独为一组。",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eUrcAnHqjvliKp9IsMMAw",
      "type": "text",
      "x": 1345.615090127658,
      "y": 3957.1524746347695,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f5faff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b92",
      "roundness": null,
      "seed": 955826474,
      "version": 3,
      "versionNonce": 1941838070,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1766044466563,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
