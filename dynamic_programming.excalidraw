      "updated": 1766060109087,
      "link": null,
      "locked": false,
      "text": "代码如下：",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "代码如下：",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nj87-1_oxqmFHl0IuzdfY",
      "type": "text",
      "x": 233.89273113315517,
      "y": 5603.3570192650695,
      "width": 703.9990234375,
      "height": 1000,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f5faff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9k",
      "roundness": null,
      "seed": 786696249,
      "version": 1032,
      "versionNonce": 849213433,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766060748872,
      "link": null,
      "locked": false,
      "text": "#include <iostream>\n#include <algorithm>\n#include <cstring>\n\nusing namespace std;\n\nconst int NN = 20010;\n\nint N,V;  // 物品数量、背包总体积\nint f[NN];\n\nint main(){\n    \n    cin >> N >> V;\n    \n    for (int i = 1; i <= N; i++) {\n        // 输入每个背包的体积、价值、个数\n        int a, b , s;\n        cin >> a >> b >> s;\n        \n        // 完全背包问题\n        if (s == 0) {\n            for (int j = a; j <= V; j++ )   f[j] = max(f[j], f[j - a] + b);\n        }\n        // 多重背包问题\n        else {\n            int k = 1;\n            while (k <= s) {\n                int vol = a * k;\n                int val = b * k;\n                for (int j = V; j >= vol; j--) f[j] = max(f[j], f[j-vol] + val);\n                s -= k;\n                k *= 2;\n            }\n            // 剩余的物品数量单独处理\n            if (s > 0){\n                int vol = a * s;\n                int val = b * s;\n                for (int j = V; j >= vol; j--) f[j] = max(f[j], f[j-vol] + val);\n                \n            }    \n        }\n    }    \n    // 输出最终结果\n    cout << f[V];\n\n    return 0;\n}\n\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#include <iostream>\n#include <algorithm>\n#include <cstring>\n\nusing namespace std;\n\nconst int NN = 20010;\n\nint N,V;  // 物品数量、背包总体积\nint f[NN];\n\nint main(){\n    \n    cin >> N >> V;\n    \n    for (int i = 1; i <= N; i++) {\n        // 输入每个背包的体积、价值、个数\n        int a, b , s;\n        cin >> a >> b >> s;\n        \n        // 完全背包问题\n        if (s == 0) {\n            for (int j = a; j <= V; j++ )   f[j] = max(f[j], f[j - a] + b);\n        }\n        // 多重背包问题\n        else {\n            int k = 1;\n            while (k <= s) {\n                int vol = a * k;\n                int val = b * k;\n                for (int j = V; j >= vol; j--) f[j] = max(f[j], f[j-vol] + val);\n                s -= k;\n                k *= 2;\n            }\n            // 剩余的物品数量单独处理\n            if (s > 0){\n                int vol = a * s;\n                int val = b * s;\n                for (int j = V; j >= vol; j--) f[j] = max(f[j], f[j-vol] + val);\n                \n            }    \n        }\n    }    \n    // 输出最终结果\n    cout << f[V];\n\n    return 0;\n}\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
