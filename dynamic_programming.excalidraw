    {
      "id": "RQlaw8Zz-zfeVi0zspsb3",
      "type": "text",
      "x": 1335.999984741211,
      "y": 178.99999618530273,
      "width": 459.7998962402344,
      "height": 439.0909090909092,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0T",
      "roundness": null,
      "seed": 1058947607,
      "version": 196,
      "versionNonce": 1337128438,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766045251588,
      "link": null,
      "locked": false,
      "text": "#include <iostream>\n#include <algorithm>\n\nconst int N = 1010;\nint n,m;\nint v[N],w[N];\nint f[N];\n\nint main(){\n    std::cin >> n >> m;\n    for (int i = 0; i < n; i++)\n        std::cin >> v[i] >> w[i];\n    for (int i = 1; i <= n; i++)\n        for (int j = m; j >= v[i]; j--) \n           f[j] = std::max(f[j],f[j-v[i]] + w[i]);\n    std::cout<< f[m] << std::endl;\n\n    return 0;\n}\n\n",
      "fontSize": 16.72727272727273,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#include <iostream>\n#include <algorithm>\n\nconst int N = 1010;\nint n,m;\nint v[N],w[N];\nint f[N];\n\nint main(){\n    std::cin >> n >> m;\n    for (int i = 0; i < n; i++)\n        std::cin >> v[i] >> w[i];\n    for (int i = 1; i <= n; i++)\n        for (int j = m; j >= v[i]; j--) \n           f[j] = std::max(f[j],f[j-v[i]] + w[i]);\n    std::cout<< f[m] << std::endl;\n\n    return 0;\n}\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
