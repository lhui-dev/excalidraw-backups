    {
      "id": "HaG0bdOKoCBV2BFqsOOyP",
      "type": "text",
      "x": 1228.2002718586791,
      "y": 1621.7910042896822,
      "width": 1056.7957374488574,
      "height": 17.874354107679448,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
