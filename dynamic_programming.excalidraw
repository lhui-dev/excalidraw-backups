      "isDeleted": false,
      "boundElements": [],
      "updated": 1765270666686,
      "link": null,
      "locked": false,
      "text": "第i个物品不考虑时，有：f(i,j) = f(i-1,j)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "第i个物品不考虑时，有：f(i,j) = f(i-1,j)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Oc_qd2BcM5TRuXXMnSw_P",
      "type": "text",
      "x": 1424.5809197728372,
      "y": 1102.3068442613028,
      "width": 147.60803847910068,
      "height": 46.127512024718975,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3a",
      "roundness": null,
      "seed": 177427877,
      "version": 200,
      "versionNonce": 1721681675,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765271016559,
      "link": null,
      "locked": false,
      "text": "曲线救国",
      "fontSize": 36.90200961977517,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "曲线救国",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "66kIZIoi2jQ5M-EvH2OC5",
      "type": "text",
      "x": 1623.440216361028,
      "y": 1121.4186152984425,
      "width": 216.92787170410156,
      "height": 60,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3e",
      "roundness": null,
      "seed": 562042891,
      "version": 223,
      "versionNonce": 327923179,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765271093109,
      "link": null,
      "locked": false,
      "text": "1. 去掉k个第i个物品\n2. 求最大价值：f(i-1,j-v[i]*k)\n3. 再把k个第i个物品加回来",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. 去掉k个第i个物品\n2. 求最大价值：f(i-1,j-v[i]*k)\n3. 再把k个第i个物品加回来",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "A_LTAheMDeMwlzU6_1s9-",
      "type": "ellipse",
      "x": 1591.5064962165784,
      "y": 1089.9688596496262,
      "width": 276.7579973666484,
      "height": 125.79905950953093,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3f",
      "roundness": {
        "type": 2
      },
      "seed": 1828508235,
