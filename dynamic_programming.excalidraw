    {
      "id": "mGEynWiH5equ3tY6UXevY",
      "type": "text",
      "x": 600.9999847412109,
      "y": 173.03225176536967,
      "width": 543.6363636363639,
      "height": 479.1666666666667,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "as",
      "roundness": null,
      "seed": 1638870616,
      "version": 1310,
      "versionNonce": 219998678,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765273837218,
      "link": null,
      "locked": false,
      "text": "#define <iostream>\n#define <algorithm>\n\nconst int N = 1010;\nint n,m; // n代表物品数量，m代表背包体积\nint v[N],w[N];  // 第 i件物品的体积和价值\nint f[N][N];\n\nint main(){\n    std::cin >> n >> m;\n    for (int i = 0; i < n; i++)\n        std::cin >> v[i] >> w[i];\n    for (int i = 1; i <= n; i++)\n        for (int j = 1 ; j <= m; j++) {\n              f[i][j] = f[i-1][j];\n              if (j >= v[i])\n                    f[i][j] = std::max(f[i][j],f[i-1][j-v[i]] +\nw[i]);\n        }\n    std::cout<< f[n][m] << std::endl;\n\n    return 0;\n}\n\n",
      "fontSize": 15.333333333333334,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#define <iostream>\n#define <algorithm>\n\nconst int N = 1010;\nint n,m; // n代表物品数量，m代表背包体积\nint v[N],w[N];  // 第 i件物品的体积和价值\nint f[N][N];\n\nint main(){\n    std::cin >> n >> m;\n    for (int i = 0; i < n; i++)\n        std::cin >> v[i] >> w[i];\n    for (int i = 1; i <= n; i++)\n        for (int j = 1 ; j <= m; j++) {\n              f[i][j] = f[i-1][j];\n              if (j >= v[i])\n                    f[i][j] = std::max(f[i][j],f[i-1][j-v[i]] + w[i]);\n        }\n    std::cout<< f[n][m] << std::endl;\n\n    return 0;\n}\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
