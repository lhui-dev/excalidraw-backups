      "isDeleted": false,
      "boundElements": [],
      "updated": 1765286063612,
      "link": null,
      "locked": false,
      "text": "那么状态转移方程为：",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "那么状态转移方程为：",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IjwdBMzCCS9PZXFP68txT",
      "type": "text",
      "x": -33.2843007863147,
      "y": 140.9193239216088,
      "width": 385.63970947265625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5A",
      "roundness": null,
      "seed": 2093473238,
      "version": 218,
      "versionNonce": 798777686,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765286777424,
      "link": null,
      "locked": false,
      "text": " f(i,j) = max( f(i-1,j), f(i-1,j-v[i]) + w(i) )",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " f(i,j) = max( f(i-1,j), f(i-1,j-v[i]) + w(i) )",
      "autoResize": true,
      "lineHeight": 1.25
    },
