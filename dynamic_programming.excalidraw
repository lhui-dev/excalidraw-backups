      "isDeleted": false,
      "boundElements": [],
      "updated": 1765269638429,
      "link": null,
      "locked": false,
      "text": "因此： f(i,j) = max(f(i-1,j), f(i-1,j-v[i]) + w(i))",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "因此： f(i,j) = max(f(i-1,j), f(i-1,j-v[i]) + w(i))",
      "autoResize": true,
      "lineHeight": 1.25
    },
