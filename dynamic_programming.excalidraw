      "originalText": "",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FGv48xcJMIMkY303EbIAN",
      "type": "text",
      "x": 2032.243621915777,
      "y": 3263.692872602343,
      "width": 985,
      "height": 1525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f5faff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b93",
      "roundness": null,
      "seed": 1762063466,
      "version": 312,
      "versionNonce": 834291254,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766045498747,
      "link": null,
      "locked": false,
      "text": "\n#include <iostream>\n#include <algorithm>\n\nusing namespace std;\n\nconst int N = 25000;\nconst int M = 2010;\n\n/// n: 物品个数\n/// total_capacity: 背包总容量\nint n, total_capacity;\n/// 每个物品的体积和价值\nint volume[N], value[N];\nint f[N];\n\nint main() {\n\n    cin >> n >> total_capacity;\n    int cnt = 0; // 拆分成多少个物品\n    for (int i = 1; i <= n; i++) {\n\n        int a, b, s; // 当前物品的体积、价值、个数\n        cin >> a >> b >> s;\n\n        // 从1开始划分\n        int k = 1;\n        // a = 1\n        // b = 2\n        // s = 6  --> 6 = 1 + 2 + 3\n        while (k <= s) { // k=1<=6 -->k=2<=5 --> k==4>=3\n            cnt++; // 1-->2\n            volume[cnt] = a * k; //拆分后物品的体积  // volume[1]=1*1=1 --> volume[2]=1*2=2\n            value[cnt] = b * k; // 拆分后物品的价值   // value[1]=2*1=2 --> value[2]=2*2=4\n            s = s - k;  // s=5 --> s=3\n            k = k * 2;  // k=2  --> k=4\n        }\n        // 剩下的无法被拆分的单独作为一组\n        if (s > 0) { // s = 3\n            cnt++; // cnt = 3\n            volume[cnt] = a * s; // volume[3]=1*3=3\n            value[cnt] = b * s; // value[3]=2*3=6\n        }\n    }\n    // 将 拆分后的物品个数 赋值给 原来的物品个数\n    n = cnt;\n\n    // 拆分后每个物品只能被选择0次或者1次\n    // 按照01背包的思路求解\n    // 遍历n个物品\n    for (int i = 1; i <= n; i++) {\n        // 从大到小遍历\n        for (int j = total_capacity; j >= volume[i]; j--) {\n            f[j] = max(f[j], f[j - volume[i]] + value[i]);\n        }\n    }\n    // 输入最大价值\n    cout << f[total_capacity] << endl;\n    return 0;\n}\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n#include <iostream>\n#include <algorithm>\n\nusing namespace std;\n\nconst int N = 25000;\nconst int M = 2010;\n\n/// n: 物品个数\n/// total_capacity: 背包总容量\nint n, total_capacity;\n/// 每个物品的体积和价值\nint volume[N], value[N];\nint f[N];\n\nint main() {\n\n    cin >> n >> total_capacity;\n    int cnt = 0; // 拆分成多少个物品\n    for (int i = 1; i <= n; i++) {\n\n        int a, b, s; // 当前物品的体积、价值、个数\n        cin >> a >> b >> s;\n\n        // 从1开始划分\n        int k = 1;\n        // a = 1\n        // b = 2\n        // s = 6  --> 6 = 1 + 2 + 3\n        while (k <= s) { // k=1<=6 -->k=2<=5 --> k==4>=3\n            cnt++; // 1-->2\n            volume[cnt] = a * k; //拆分后物品的体积  // volume[1]=1*1=1 --> volume[2]=1*2=2\n            value[cnt] = b * k; // 拆分后物品的价值   // value[1]=2*1=2 --> value[2]=2*2=4\n            s = s - k;  // s=5 --> s=3\n            k = k * 2;  // k=2  --> k=4\n        }\n        // 剩下的无法被拆分的单独作为一组\n        if (s > 0) { // s = 3\n            cnt++; // cnt = 3\n            volume[cnt] = a * s; // volume[3]=1*3=3\n            value[cnt] = b * s; // value[3]=2*3=6\n        }\n    }\n    // 将 拆分后的物品个数 赋值给 原来的物品个数\n    n = cnt;\n\n    // 拆分后每个物品只能被选择0次或者1次\n    // 按照01背包的思路求解\n    // 遍历n个物品\n    for (int i = 1; i <= n; i++) {\n        // 从大到小遍历\n        for (int j = total_capacity; j >= volume[i]; j--) {\n            f[j] = max(f[j], f[j - volume[i]] + value[i]);\n        }\n    }\n    // 输入最大价值\n    cout << f[total_capacity] << endl;\n    return 0;\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
