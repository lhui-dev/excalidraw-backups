      "link": null,
      "locked": false,
      "text": "F[i，j]表示前i件物品恰好放入容量为j的背包可以获得的最大价值",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "F[i，j]表示前i件物品恰好放入容量为j的背包可以获得的最大价值",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kVw0wTXDsx2Pht8NsG5_B",
      "type": "text",
      "x": -140.46446639503864,
      "y": 106.41930357655667,
      "width": 200,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#f5faff",
      "fillStyle": "solid",
      "strokeWidth": 1,
