    {
      "id": "dDqdQyzDXMBxJxptyoDe_",
      "type": "text",
      "x": -138.46461898292836,
      "y": -53.74713166514118,
      "width": 56,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f5faff",
      "fillStyle": "solid",
