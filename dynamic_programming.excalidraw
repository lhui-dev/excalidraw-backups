    {
      "id": "-Met_eHcGKWMUdUy1TLZm",
      "type": "text",
      "x": 728.6298146569411,
      "y": 9036.92588827648,
      "width": 313.83990478515625,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f5faff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7h",
      "roundness": null,
      "seed": 1776639318,
      "version": 373,
      "versionNonce": 1612495385,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766060596607,
      "link": null,
      "locked": false,
      "text": "假设我们从5的位置走到f[i][j] = 6的位置：\n\n我们可以从5->8->6或者5->4->6",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "假设我们从5的位置走到f[i][j] = 6的位置：\n\n我们可以从5->8->6或者5->4->6",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xzd5m8UZ5YyhNfrw5wXA6",
      "type": "text",
      "x": 732.349728766749,
      "y": 9112.620255337883,
      "width": 384,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f5faff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7i",
      "roundness": null,
      "seed": 1933951382,
      "version": 262,
      "versionNonce": 9441017,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766060596607,
      "link": null,
      "locked": false,
      "text": "因此我们需要讨论两种情况：从左上到达；从右上到达",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "因此我们需要讨论两种情况：从左上到达；从右上到达",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
