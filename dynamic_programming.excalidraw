      "updated": 1765270717998,
      "link": null,
      "locked": false,
      "text": "以此类推\n当我们第i个物品选择k次时，有：",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "以此类推\n当我们第i个物品选择k次时，有：",
      "autoResize": true,
      "lineHeight": 1.25
    },
