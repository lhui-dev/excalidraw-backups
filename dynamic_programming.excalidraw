      "versionNonce": 1266557206,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765274630101,
      "link": null,
      "locked": false,
      "text": "f(i,j-v[i]) = Max(           f(i-1,j-v[i]) ,          f(i-1,j-v[i]*2) + w[i] ,     f(i-1,j-v[i]*3) + w[i]*2 , ... + f(i-1,j-v[i]*k) + w[i]*(k-1) , ... )",
      "fontSize": 14.299483286143557,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(i,j-v[i]) = Max(           f(i-1,j-v[i]) ,          f(i-1,j-v[i]*2) + w[i] ,     f(i-1,j-v[i]*3) + w[i]*2 , ... + f(i-1,j-v[i]*k) + w[i]*(k-1) , ... )",
      "autoResize": false,
      "lineHeight": 1.25
    },
