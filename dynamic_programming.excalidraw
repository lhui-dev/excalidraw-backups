      "isDeleted": false,
      "boundElements": [],
      "updated": 1765270806908,
      "link": null,
      "locked": false,
      "text": "此时，f(i,j) = f(i-1, j - v[i] * 2) + 2 *w[i] ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "此时，f(i,j) = f(i-1, j - v[i] * 2) + 2 *w[i] ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EoVJt8xI3MnZiyos4LNy5",
      "type": "text",
      "x": 1431.42475774664,
