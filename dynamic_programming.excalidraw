      "seed": 1805941899,
      "version": 415,
      "versionNonce": 1651485206,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765274625351,
      "link": null,
      "locked": false,
      "text": "f(i,j) = max( f(i-1,j), f(i,j-v[i])+w[i] )",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(i,j) = max( f(i-1,j), f(i,j-v[i])+w[i] )",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Y3Q2Llryltel3u8Kp5rTJ",
      "type": "text",
      "x": 1701.34989660499,
      "y": 1659.0684002864616,
      "width": 230.6599884033203,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4Z",
      "roundness": null,
      "seed": 1236050533,
      "version": 297,
      "versionNonce": 101127830,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765274651531,
      "link": null,
      "locked": false,
      "text": "此时状态转移方程与k无关",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "此时状态转移方程与k无关",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "s8MwmtppyiVzp_VNfz9fw",
      "type": "text",
      "x": 1316.720152739192,
      "y": 1755.6703510158475,
      "width": 629.2864060797768,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4a",
      "roundness": null,
      "seed": 1786025637,
      "version": 417,
      "versionNonce": 82053770,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765274718334,
      "link": null,
      "locked": false,
      "text": "#include <iostream>\n#include <algorithm>\n\nconst int N = 1010;\n\nint n, m;\nint v[N], w[N];\nint dp[N][N];\n\nint main() {\n    std::cin >> n >> m;\n    for (int i = 1; i <= n; i++)\n        std::cin >> v[i] >> w[i];\n\n    for (int i = 1; i <= n; i++) {\n        for (int j = 0; j <= m; j++) {\n            dp[i][j] = dp[i - 1][j];\n            if (j >= v[i])\n                dp[i][j] = std::max(dp[i][j], dp[i][j - v[i]] + w[i]);\n        }\n    }\n    std::cout << dp[n][m];\n    return 0;\n}\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#include <iostream>\n#include <algorithm>\n\nconst int N = 1010;\n\nint n, m;\nint v[N], w[N];\nint dp[N][N];\n\nint main() {\n    std::cin >> n >> m;\n    for (int i = 1; i <= n; i++)\n        std::cin >> v[i] >> w[i];\n\n    for (int i = 1; i <= n; i++) {\n        for (int j = 0; j <= m; j++) {\n            dp[i][j] = dp[i - 1][j];\n            if (j >= v[i])\n                dp[i][j] = std::max(dp[i][j], dp[i][j - v[i]] + w[i]);\n        }\n    }\n    std::cout << dp[n][m];\n    return 0;\n}\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
