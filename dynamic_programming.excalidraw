      "link": null,
      "locked": false,
      "text": "#include <iostream>\n#include <algorithm>\n\nconst int N = 1010;\n\nint n, m;\nint v[N], w[N];\nint dp[N];\n\nint main() {\n\n    std::cin >> n >> m;\n    for (int i = 1; i <= n; i++)\n        std::cin >> v[i] >> w[i];\n\n    for (int i = 1; i <= n; i++) {\n        for (int j = v[i]; j <= m; j++) {\n            dp[j] = std::max(dp[j], dp[j - v[i]] + w[i]);\n        }\n    }\n    std::cout << dp[m];\n\n    return 0;\n}\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#include <iostream>\n#include <algorithm>\n\nconst int N = 1010;\n\nint n, m;\nint v[N], w[N];\nint dp[N];\n\nint main() {\n\n    std::cin >> n >> m;\n    for (int i = 1; i <= n; i++)\n        std::cin >> v[i] >> w[i];\n\n    for (int i = 1; i <= n; i++) {\n        for (int j = v[i]; j <= m; j++) {\n            dp[j] = std::max(dp[j], dp[j - v[i]] + w[i]);\n        }\n    }\n    std::cout << dp[m];\n\n    return 0;\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
