    {
      "id": "G-mFlYL1J7TNZz6ktfwUQ",
      "type": "text",
      "x": 470.68473939420755,
      "y": 1114.5644475253328,
      "width": 283.8398742675781,
      "height": 20,
      "angle": 0,
