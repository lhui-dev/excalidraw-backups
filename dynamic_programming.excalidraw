      "updated": 1765372249273,
      "link": null,
      "locked": false,
      "text": "#include <iostream>\n#include <algorithm>\n#include <cstring>\n\nusing namespace std;\n\nconst int N = 1010;\n\nint n, m;\nint v[N], w[N], s[N]; // 第i个物品的体积、价值、数量\nint f[N][N];\n\nint main() {\n    // 题目没有要求我们恰好装满背包，故将F[0...V]全部初始化为0\n    for (int i = 0; i < N; i++) {\n        f[i][i] = 0;\n    }\n\n    cin >> n >> m;\n    for (int i = 1; i <= n; i++) {\n        cin >> v[i] >> w[i] >> s[i];\n    }\n\n    //FIXME 优化时间复杂度\n    for (int i = 1; i <= n; i++) {\n        for (int j = 0; j <= m; j++) {\n            for (int k = 0; k <= s[i] && k * v[i] <= j; k++) {\n                f[i][j] = max(f[i][j], f[i - 1][j - k * v[i]] + k * w[i]);\n            }\n        }\n    }\n    cout << f[n][m] << endl;\n\n    return 0;\n}\n",
      "fontSize": 15.174602205791178,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#include <iostream>\n#include <algorithm>\n#include <cstring>\n\nusing namespace std;\n\nconst int N = 1010;\n\nint n, m;\nint v[N], w[N], s[N]; // 第i个物品的体积、价值、数量\nint f[N][N];\n\nint main() {\n    // 题目没有要求我们恰好装满背包，故将F[0...V]全部初始化为0\n    for (int i = 0; i < N; i++) {\n        f[i][i] = 0;\n    }\n\n    cin >> n >> m;\n    for (int i = 1; i <= n; i++) {\n        cin >> v[i] >> w[i] >> s[i];\n    }\n\n    //FIXME 优化时间复杂度\n    for (int i = 1; i <= n; i++) {\n        for (int j = 0; j <= m; j++) {\n            for (int k = 0; k <= s[i] && k * v[i] <= j; k++) {\n                f[i][j] = max(f[i][j], f[i - 1][j - k * v[i]] + k * w[i]);\n            }\n        }\n    }\n    cout << f[n][m] << endl;\n\n    return 0;\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
