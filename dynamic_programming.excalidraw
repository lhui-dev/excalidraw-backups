    {
      "id": "ESYYTd55Y_7SDGdmcJPcX",
      "type": "text",
      "x": 1326.2509349815498,
      "y": 1660.7516245822592,
      "width": 347.99969482421875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
