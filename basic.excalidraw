    },
    {
      "id": "3Prj3vJJFoWtr38S_J-KS",
      "type": "text",
      "x": -271.44066019060256,
      "y": 5122.23981379626,
      "width": 658.7195434570312,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
