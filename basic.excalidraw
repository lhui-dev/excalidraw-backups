      "isDeleted": false,
      "boundElements": null,
      "updated": 1772350185154,
      "link": null,
      "locked": false,
      "text": "s[i][j] = s[i-1][j]+s[i][j-1]-s[i-1][j-1]+a[i][j]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "s[i][j] = s[i-1][j]+s[i][j-1]-s[i-1][j-1]+a[i][j]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ho3sJxntIpUo53Zps3PNL",
      "type": "text",
      "x": 357.257613541244,
      "y": 806.8429042271205,
      "width": 672.5394287109375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
