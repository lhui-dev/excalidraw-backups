      "isDeleted": false,
      "boundElements": [],
      "updated": 1772349892925,
      "link": null,
      "locked": false,
      "text": "一维前缀和\n",
      "fontSize": 33.25714111328124,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "一维前缀和\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "O1onKEkH_rpP5ax-AM3m6",
      "type": "text",
