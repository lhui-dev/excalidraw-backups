      "version": 56,
      "versionNonce": 294174093,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1772349080078,
      "link": null,
      "locked": false,
      "text": "(方便处理边界)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(方便处理边界)",
