      "versionNonce": 915762627,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1772349080078,
      "link": null,
      "locked": false,
      "text": "S = a[1]*a[2]+a[1]*a[3]+...+a[1]*a[n]+ a[2]*a[3]+...a[2]*a[n] + ....",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "S = a[1]*a[2]+a[1]*a[3]+...+a[1]*a[n]+ a[2]*a[3]+...a[2]*a[n] + ....",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4vIOQNfhgTs3tLNaeCC5K",
      "type": "text",
      "x": -405.9861147360571,
      "y": 5172.421670818632,
      "width": 1167.4990234375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGZ",
      "roundness": null,
      "seed": 669392466,
      "version": 235,
      "versionNonce": 974357485,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1772349080078,
      "link": null,
      "locked": false,
      "text": "a[1](a[2]+a[3]+...a[n]) + a[2](a[3]+a[4]+...+a[n]) + ...+ a[n-3](a[n-2]+a[n-1]+a[n]) +a[n-2](a[n-1]+a[n]) + a[n-1](a[n])",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a[1](a[2]+a[3]+...a[n]) + a[2](a[3]+a[4]+...+a[n]) + ...+ a[n-3](a[n-2]+a[n-1]+a[n]) +a[n-2](a[n-1]+a[n]) + a[n-1](a[n])",
      "autoResize": true,
      "lineHeight": 1.25
    },
