      "versionNonce": 1451561891,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1772349080078,
      "link": null,
      "locked": false,
      "text": "已知a[1],a[2],a[3],...a[n]；S[i] = a[1]+a[2]+a[3]+...+a[n]\n如何求S[i]？",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "已知a[1],a[2],a[3],...a[n]；S[i] = a[1]+a[2]+a[3]+...+a[n]\n如何求S[i]？",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GQPhVMuCZaMNzFyL4q4Uz",
      "type": "text",
      "x": -354.1679329178753,
      "y": 4712.967103169484,
      "width": 60,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGI",
      "roundness": null,
      "seed": 1320846798,
      "version": 4,
      "versionNonce": 247573517,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1772349080078,
      "link": null,
      "locked": false,
      "text": "前缀和\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "前缀和\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UnV5ii5N5CoOa9KyQDwQK",
      "type": "text",
      "x": -341.07700163236393,
      "y": 4805.148943545904,
      "width": 175.33982849121094,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGJ",
      "roundness": null,
      "seed": 2033092818,
      "version": 170,
      "versionNonce": 2022221635,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1772349080078,
      "link": null,
      "locked": false,
      "text": "① S[i]=S[i-1]+a[i]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "① S[i]=S[i-1]+a[i]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "zNWjAQNBub7FWLg6_f0-0",
      "type": "text",
      "x": -341.80431874884124,
      "y": 4836.967097620834,
      "width": 95.37995910644531,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
