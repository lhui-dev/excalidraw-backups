      "seed": 1972362400,
      "version": 159,
      "versionNonce": 88692064,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772349753643,
      "link": null,
      "locked": false,
      "text": "利用前缀和我们可以快速求出数组中某一段的和",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "利用前缀和我们可以快速求出数组中某一段的和",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7E4AsFW3QyTPxoc0eRW4b",
      "type": "text",
      "x": 298.5583981600675,
      "y": 412.5181773792601,
      "width": 410.699951171875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGg",
      "roundness": null,
      "seed": 1017858208,
      "version": 209,
      "versionNonce": 808954208,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772349753643,
      "link": null,
      "locked": false,
      "text": "假如我们要计算区间[L,R]内所有数的和，那么",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "假如我们要计算区间[L,R]内所有数的和，那么",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fri85voneubDEZ4Zzll78",
      "type": "text",
      "x": 702.7402635054154,
      "y": 402.8816417347289,
      "width": 456.1195983886719,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGh",
      "roundness": null,
      "seed": 1702442144,
      "version": 216,
      "versionNonce": 305888608,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772349753643,
      "link": null,
      "locked": false,
      "text": "S[R] = a[1]+a[2]+a[3]+...+a[L-1]+a[L]+...+a[R]\nS[L-1] = a[1]+a[2]+a[3]+...+a[L-1]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "S[R] = a[1]+a[2]+a[3]+...+a[L-1]+a[L]+...+a[R]\nS[L-1] = a[1]+a[2]+a[3]+...+a[L-1]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mHSvyhWM3jl19NbCBHeWq",
