      "type": "text",
      "x": 299.1038721257991,
      "y": 362.8817527077417,
      "width": 420,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
