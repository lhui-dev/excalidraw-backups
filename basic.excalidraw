      "versionNonce": 672712419,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1772349080078,
      "link": null,
      "locked": false,
      "text": "利用前缀和我们可以快速求出数组中某一段的和",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "利用前缀和我们可以快速求出数组中某一段的和",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bPGh6MX0ulQAmblUquVYA",
      "type": "text",
      "x": -338.3497705199705,
      "y": 4922.239841539512,
      "width": 410.699951171875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGP",
      "roundness": null,
      "seed": 2105194258,
      "version": 166,
      "versionNonce": 400936141,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1772349080078,
      "link": null,
      "locked": false,
      "text": "假如我们要计算区间[L,R]内所有数的和，那么",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "假如我们要计算区间[L,R]内所有数的和，那么",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qCMzyuAbNKpnOYTqAS9fj",
      "type": "text",
      "x": 65.83209482537751,
      "y": 4912.60330589498,
      "width": 456.1195983886719,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGQ",
      "roundness": null,
      "seed": 587283538,
      "version": 173,
      "versionNonce": 465826435,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1772349080078,
      "link": null,
      "locked": false,
      "text": "S[R] = a[1]+a[2]+a[3]+...+a[L-1]+a[L]+...+a[R]\nS[L-1] = a[1]+a[2]+a[3]+...+a[L-1]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "S[R] = a[1]+a[2]+a[3]+...+a[L-1]+a[L]+...+a[R]\nS[L-1] = a[1]+a[2]+a[3]+...+a[L-1]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Boo1yqb9a1xKlzPG_2Ez_",
      "type": "text",
      "x": -326.16793014355,
      "y": 4957.876188529925,
      "width": 20,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGT",
      "roundness": null,
      "seed": 1337370706,
      "version": 28,
      "versionNonce": 1754049325,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1772349080078,
      "link": null,
      "locked": false,
      "text": "即",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "即",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mJwfC442uABEVjD64xsyi",
      "type": "text",
      "x": -301.62248946972187,
      "y": 4956.967014391075,
      "width": 129.599853515625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
