      "isDeleted": true,
      "boundElements": [],
      "updated": 1772349080078,
      "link": null,
      "locked": false,
      "text": "S[R] - S[L-1]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "S[R] - S[L-1]",
