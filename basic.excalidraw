      "isDeleted": false,
      "boundElements": null,
      "updated": 1772350182855,
      "link": null,
      "locked": false,
      "text": "(x1,y1)->(x2,y2) ==> s[x2][y2]-s[x2][y1-1]-s[x1-1][y2]+s[x1-1][y1-1]",
