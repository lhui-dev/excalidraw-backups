      "seed": 1739621536,
      "version": 213,
      "versionNonce": 2104307040,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772349753643,
      "link": null,
      "locked": false,
      "text": "① S[i]=S[i-1]+a[i]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "① S[i]=S[i-1]+a[i]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
