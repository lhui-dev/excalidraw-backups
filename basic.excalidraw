      "isDeleted": false,
      "boundElements": null,
      "updated": 1772351646903,
      "link": null,
      "locked": false,
      "text": "已知a[1],a[2],a[3]...a[n], 构造b[1],b[2],b[3]...b[n],使得",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "已知a[1],a[2],a[3]...a[n], 构造b[1],b[2],b[3]...b[n],使得",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aNaDDXC_J2eRI6DYhF-Zm",
      "type": "text",
      "x": 817.974204372319,
      "y": 1431.6668992793186,
      "width": 225.59982299804688,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH5",
      "roundness": null,
      "seed": 517082272,
      "version": 48,
      "versionNonce": 1966500000,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772351452998,
      "link": null,
      "locked": false,
      "text": "a[i] = b[1]+b[2]+..+b[i]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a[i] = b[1]+b[2]+..+b[i]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SPDN9oHo8vSS7f8LqSPbR",
      "type": "text",
      "x": 284.3645510069445,
      "y": 1475.9585754514837,
      "width": 477.4799499511719,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH6",
      "roundness": null,
      "seed": 801877152,
      "version": 115,
      "versionNonce": 1075776672,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772351617816,
      "link": null,
      "locked": false,
      "text": "即：A数组是B数组的前缀和；B数组称为A数组的差分",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "即：A数组是B数组的前缀和；B数组称为A数组的差分",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "thazWpPidJ2BpBHh-3nEl",
      "type": "text",
      "x": 295.7011272625228,
      "y": 1511.2865098240204,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH7",
      "roundness": null,
      "seed": 240432288,
      "version": 4,
      "versionNonce": 1772872032,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1772351494279,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "f9_k3fvQ5yAZqUaADno_d",
      "type": "text",
      "x": 364.5962101409654,
      "y": 1532.3712768410085,
      "width": 200.5473934212091,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH8",
      "roundness": null,
      "seed": 111983776,
      "version": 318,
      "versionNonce": 1674104992,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772351771321,
      "link": null,
      "locked": false,
      "text": "b[1]=a[1]\nb[2]=a[2]-a[1]\nb[3]=a[3]-a[2]\n...\nb[n]=a[n]-a[n-1]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "b[1]=a[1]\nb[2]=a[2]-a[1]\nb[3]=a[3]-a[2]\n...\nb[n]=a[n]-a[n-1]",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "a3B0pgHGE7td1XXUTazuz",
      "type": "text",
      "x": 284.2572075080945,
      "y": 1534.864459919026,
      "width": 60,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH9",
      "roundness": null,
      "seed": 208050528,
      "version": 133,
      "versionNonce": 141619552,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772351757889,
      "link": null,
      "locked": false,
      "text": "构造：",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "构造：",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BE7hOMYg_JFl8RMwjMYRq",
      "type": "text",
      "x": 590.0998465444352,
      "y": 1537.5449187716763,
      "width": 408.7399597167969,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHA",
      "roundness": null,
      "seed": 210371936,
      "version": 209,
      "versionNonce": 1876134240,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772351901724,
      "link": null,
      "locked": false,
      "text": "如果已知B数组，需得到A数组，\n我们只需对B数组求一遍前缀和集合得到A数组",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "如果已知B数组，需得到A数组，\n我们只需对B数组求一遍前缀和集合得到A数组",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3Fx9b5mjcot9zVZw0ZxkR",
      "type": "text",
      "x": 342.03800102148307,
      "y": 1718.9153423566327,
      "width": 710.9599609375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHB",
      "roundness": null,
      "seed": 1405113696,
      "version": 94,
      "versionNonce": 1328949600,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772352527925,
      "link": null,
      "locked": false,
      "text": "对原数组 a的区间 [l, r]加上一个值 c，等价于在差分数组 d上只修改两个位置：\nd[l] += c\nd[r+1] -= c(如果 r+1 在数组范围内)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "对原数组 a的区间 [l, r]加上一个值 c，等价于在差分数组 d上只修改两个位置：\nd[l] += c\nd[r+1] -= c(如果 r+1 在数组范围内)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kyCWC85GTC_qSCor8bMje",
      "type": "text",
      "x": 274.0241210051768,
      "y": 1684.908359106401,
      "width": 140,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHC",
      "roundness": null,
      "seed": 1402795168,
      "version": 62,
      "versionNonce": 392688800,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772352544176,
      "link": null,
      "locked": false,
      "text": "差分的重要性质",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "差分的重要性质",
