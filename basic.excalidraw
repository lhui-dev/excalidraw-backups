      "isDeleted": true,
      "boundElements": [],
      "updated": 1772349080078,
      "link": null,
      "locked": false,
      "text": "② S[0]=0",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "② S[0]=0",
