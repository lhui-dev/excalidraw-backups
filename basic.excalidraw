      "lineHeight": 1.25
    },
    {
      "id": "0THO1eBEs9OuS_B-imMlO",
      "type": "text",
      "x": -337.8042965542389,
      "y": 4872.603416867993,
      "width": 420,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
