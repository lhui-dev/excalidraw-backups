      "isDeleted": false,
      "boundElements": [],
      "updated": 1772349753643,
      "link": null,
      "locked": false,
      "text": "已知a[1],a[2],a[3],...a[n]；S[i] = a[1]+a[2]+a[3]+...+a[n]\n如何求S[i]？",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "已知a[1],a[2],a[3],...a[n]；S[i] = a[1]+a[2]+a[3]+...+a[n]\n如何求S[i]？",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iv7K6ioVlWsVtwHpmMRzT",
      "type": "text",
      "x": 262.1688595065824,
