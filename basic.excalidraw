      "isDeleted": false,
      "boundElements": [],
      "updated": 1772349753643,
      "link": null,
      "locked": false,
      "text": "即",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "即",
      "autoResize": true,
      "lineHeight": 1.25
    },
