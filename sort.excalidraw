      "roundness": null,
      "seed": 587283538,
      "version": 172,
      "versionNonce": 326600786,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772288989397,
      "link": null,
      "locked": false,
      "text": "S[R] = a[1]+a[2]+a[3]+...+a[L-1]+a[L]+...+a[R]\nS[L-1] = a[1]+a[2]+a[3]+...+a[L-1]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "S[R] = a[1]+a[2]+a[3]+...+a[L-1]+a[L]+...+a[R]\nS[L-1] = a[1]+a[2]+a[3]+...+a[L-1]",
      "autoResize": true,
      "lineHeight": 1.25
