    },
    {
      "id": "GycU-N3IIwA9OhVtZoWcf",
      "type": "text",
      "x": 815.6313390423506,
      "y": 2060.766966330898,
      "width": 100,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bG7",
      "roundness": null,
      "seed": 325709758,
      "version": 16,
      "versionNonce": 41597666,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767451060399,
      "link": null,
      "locked": false,
      "text": "模板代码：",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "模板代码：",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SqzDPeSDqUM9omvFs6XkU",
      "type": "text",
      "x": 818.582121117671,
      "y": 2097.16156415916,
      "width": 649,
      "height": 1250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bG8",
      "roundness": null,
      "seed": 1848960190,
      "version": 1134,
      "versionNonce": 65987399,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769127084486,
      "link": null,
      "locked": false,
      "text": "#include <iostream>\n#include <algorithm>\n#include <cstring>\n\nusing namespace std;\n\nconst int N = 1000010;\n\nint n;\nint q[N],tmp[N];\n\nvoid merge_sort(int q[], int l, int r) {\n    \n    if (l >= r) return; // 为空或只有一个元素，无需排序\n\n    // 确定分界点\n    int mid = l + r >> 1;\n\n    merge_sort(q, l, mid); // 递归排序左半边\n    merge_sort(q, mid + 1, r); // 递归排序右半边\n\n    // 归并\n    // k 表示当前是第几个元素\n    // i 指向左半边第一个元素\n    // j 指向右半边第一个元素\n    int k = 0, i = l, j = mid + 1;\n\n\n    while (i <= mid && j <= r) {\n        if (q[i] <= q[j]) tmp[k++]=q[i++];\n        else tmp[k++] = q[j++];\n    }\n    \n    while (i <= mid) tmp[k++] = q[i++];\n    while (j <= r) tmp[k++] = q[j++];\n\n    for (int i = l, j = 0; i <= r; i++, j++) q[i] = tmp[j];\n}\n\nint main (){\n    scanf(\"%d\",&n);\n\n    for (int i = 0; i < n; i++) scanf(\"%d\",&q[i]);\n    \n    merge_sort(q,0, n - 1);\n\n    for (int i = 0; i < n; i++) printf(\"%d \",q[i]);\n    \n    return 0;\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#include <iostream>\n#include <algorithm>\n#include <cstring>\n\nusing namespace std;\n\nconst int N = 1000010;\n\nint n;\nint q[N],tmp[N];\n\nvoid merge_sort(int q[], int l, int r) {\n    \n    if (l >= r) return; // 为空或只有一个元素，无需排序\n\n    // 确定分界点\n    int mid = l + r >> 1;\n\n    merge_sort(q, l, mid); // 递归排序左半边\n    merge_sort(q, mid + 1, r); // 递归排序右半边\n\n    // 归并\n    // k 表示当前是第几个元素\n    // i 指向左半边第一个元素\n    // j 指向右半边第一个元素\n    int k = 0, i = l, j = mid + 1;\n\n\n    while (i <= mid && j <= r) {\n        if (q[i] <= q[j]) tmp[k++]=q[i++];\n        else tmp[k++] = q[j++];\n    }\n    \n    while (i <= mid) tmp[k++] = q[i++];\n    while (j <= r) tmp[k++] = q[j++];\n\n    for (int i = l, j = 0; i <= r; i++, j++) q[i] = tmp[j];\n}\n\nint main (){\n    scanf(\"%d\",&n);\n\n    for (int i = 0; i < n; i++) scanf(\"%d\",&q[i]);\n    \n    merge_sort(q,0, n - 1);\n\n    for (int i = 0; i < n; i++) printf(\"%d \",q[i]);\n    \n    return 0;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
