      "text": "while(i<j && arr[j] >= pivot) j--;\n if (i < j) {\n     arr[i] = arr[j];\n     i++;\n }",
      "fontSize": 10.654094610307883,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "while(i<j && arr[j] >= pivot) j--;\n if (i < j) {\n     arr[i] = arr[j];\n     i++;\n }",
      "autoResize": true,
      "lineHeight": 1.25
    },
