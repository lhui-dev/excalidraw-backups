    },
    {
      "id": "HEEYnuapaNNsEpr4fxhDr",
      "type": "text",
      "x": 584.1988633529229,
      "y": 1078.902970029686,
      "width": 176.20794677734375,
      "height": 60,
      "angle": 0,
      "strokeColor": "#e03131",
