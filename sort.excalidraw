      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bD0",
      "roundness": null,
      "seed": 2091561826,
      "version": 984,
      "versionNonce": 1104127614,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767427431498,
      "link": null,
      "locked": false,
      "text": "当前i=0, j=5 满足i<j\n① 将arr[j]放在左边的坑\n② i++",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "当前i=0, j=5 满足i<j\n① 将arr[j]放在左边的坑\n② i++",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
