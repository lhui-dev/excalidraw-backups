    {
      "id": "SmR_NoyQBUOhlxpkA1Hph",
      "type": "text",
      "x": 1744.4862223048005,
      "y": 456.42322594670213,
      "width": 685.5994262695312,
      "height": 480,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEE",
      "roundness": null,
      "seed": 943836450,
      "version": 165,
      "versionNonce": 2007941282,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767429392590,
      "link": null,
      "locked": false,
      "text": "// 挖坑法\nvoid quick_sort(int q[], int l, int r) {\n    if (l >= r) return;\n\n    int pivot = q[l];\n    int i = l, j = r;\n    while (i < j) {\n        while (i < j && q[j] >= pivot) j--; // 从后往前找第一个小于基准元素的元素\n        if (i < j) {\n            q[i] = q[j]; // 把 q[i] 放到右边的坑\n            i++; // 新的坑位置向右移动\n        }\n\n        while (i < j && q[i] <= pivot) i++; // 从前往后找第一个大于基准元素的元素\n        if (i < j) {\n            q[j] = q[i]; // 把 q[i] 放到右边的坑\n            j--; // 新的坑位置向左移动\n        }\n    }\n    q[i] = pivot; // 将基准元素放在(i==j)的坑里面\n\n    quick_sort(q, l, i - 1); // 递归处理左半边\n    quick_sort(q, i + 1, r); // 递归处理右半边\n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// 挖坑法\nvoid quick_sort(int q[], int l, int r) {\n    if (l >= r) return;\n\n    int pivot = q[l];\n    int i = l, j = r;\n    while (i < j) {\n        while (i < j && q[j] >= pivot) j--; // 从后往前找第一个小于基准元素的元素\n        if (i < j) {\n            q[i] = q[j]; // 把 q[i] 放到右边的坑\n            i++; // 新的坑位置向右移动\n        }\n\n        while (i < j && q[i] <= pivot) i++; // 从前往后找第一个大于基准元素的元素\n        if (i < j) {\n            q[j] = q[i]; // 把 q[i] 放到右边的坑\n            j--; // 新的坑位置向左移动\n        }\n    }\n    q[i] = pivot; // 将基准元素放在(i==j)的坑里面\n\n    quick_sort(q, l, i - 1); // 递归处理左半边\n    quick_sort(q, i + 1, r); // 递归处理右半边\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
